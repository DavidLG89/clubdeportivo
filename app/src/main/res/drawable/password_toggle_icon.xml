<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cuando la contraseña está visible (state_checked=true), muestra el ojo abierto -->
    <item android:state_checked="true" android:drawable="@drawable/ic_eye" />
    <!-- Por defecto (contraseña oculta), muestra el ojo tachado -->
    <item android:drawable="@drawable/ic_eye_off" />
</selector>