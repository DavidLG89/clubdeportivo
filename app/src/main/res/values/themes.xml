<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ClubDeportivo" parent="Theme.Material3.Light.NoActionBar">
        <!-- Font -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>

        <!-- Colores base para legibilidad -->
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/text_grey2</item>
        <item name="android:textColorHint">@color/black</item>

        <!-- Fondo para menús emergentes y desplegables -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
    </style>

    <style name="Theme.ClubDeportivo" parent="Base.Theme.ClubDeportivo" />

    <!-- Diálogo con botones a ancho completo -->
    <style name="ThemeOverlay.App.MaterialAlertDialog.FullWidthButtons"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DialogButton.FullWidth</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DialogButton.FullWidth</item>
    </style>

    <style name="Widget.App.DialogButton.FullWidth"
        parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:layout_width">match_parent</item>
    </style>

</resources>
