<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de progreso/Pasos -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Línea conectora de fondo -->
    <View
        android:id="@+id/lineConnector"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/color_boton_principal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/step3"
        app:layout_constraintStart_toStartOf="@+id/step1"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Paso 1 -->
    <TextView
        android:id="@+id/step1"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/circle_teal"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/step2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Paso 2 -->
    <TextView
        android:id="@+id/step2"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/circle_grey"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/step3"
        app:layout_constraintStart_toEndOf="@+id/step1"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Paso 3 -->
    <TextView
        android:id="@+id/step3"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/circle_grey"
        android:gravity="center"
        android:text="3"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/step2"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
